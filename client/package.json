{
  "name": "spyteam",
  "version": "1.0.0",
  "author": "BPO Concept",
  "description": "Application Electron sans interface graphique pour capture d'écran",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "test": "electron-builder",
    "build": "node build.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.1.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.spyteam",
    "productName": "SpyTeam",
    "files": [
      "./config.env",
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "spyteam.ico",
      "extraResources": [
        {
          "from": "config.env",
          "to": "config.env"
        },
        {
          "from": "resources/ffmpeg",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "installerIcon": "spyteam.ico",
      "uninstallerIcon": "spyteam.ico",
      "installerHeaderIcon": "spyteam.ico"
    },
    "directories": {
      "output": "windows"
    }
  }
}
